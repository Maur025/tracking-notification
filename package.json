{
	"name": "tracking-notification",
	"version": "0.0.1",
	"description": "Tracking notification server with Express and TypeScript",
	"main": "dist/index.js",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch -r tsconfig-paths/register src/index.ts",
		"build": "swc src -d dist --source-maps --copy-files && tsc --noEmit && tsc-alias -p tsconfig.json --outDir dist",
		"start": "node dist/src/index.js",
		"lint": "eslint . --ext .js,.ts,.tsx --max-warnings=0",
		"test": "vitest --config vitest.unit.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"test:all": "CI=true npm run test && CI=true npm run test:integration",
		"generate:docs": "tsoa spec && tsoa routes"
	},
	"keywords": [
		"express",
		"typescript",
		"node",
		"tracking",
		"notification"
	],
	"type": "module",
	"author": "maur025",
	"license": "MIT",
	"packageManager": "pnpm@10.18.3",
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@eslint/json": "^0.13.1",
		"@eslint/markdown": "^7.2.0",
		"@scalar/express-api-reference": "^0.8.22",
		"@swc/cli": "^0.7.8",
		"@swc/core": "^1.13.5",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.3.0",
		"@types/supertest": "^6.0.3",
		"@vitest/ui": "^3.2.4",
		"eslint": "^9.34.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.3.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.41.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@maur025/core-logger": "^1.0.0",
		"@maur025/core-model-data": "^2.1.1",
		"@tsoa/runtime": "^6.6.0",
		"bullmq": "^5.61.0",
		"compression": "^1.8.1",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"http-status-codes": "^2.3.0",
		"ioredis": "^5.8.1",
		"reflect-metadata": "^0.2.2",
		"tsoa": "^6.6.0",
		"tsyringe": "^4.10.0",
		"zod": "^4.1.12"
	}
}
